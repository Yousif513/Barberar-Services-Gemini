# Web client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Localhost-only role switcher for development. Set false to force-disable it.
NEXT_PUBLIC_ENABLE_DEV_ACCESS=true

# Expo client
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PROJECT_REF=your-project
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Supabase Edge Functions
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
TAP_SECRET_KEY=your-tap-secret-key
PAYMENT_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/payment-webhook
